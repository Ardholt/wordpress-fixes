+function rr_data() {
+    $now = time();
+    $cache = get_option('rr_cache', []);
+    // Keep last-good data separately from the refresh timer; failures cannot overwrite it.
+    if (($cache['source'] ?? '') !== rr_endpoint()) { $cache = []; }
+    if ($cache && $now - $cache['captured'] < 3600) { return [$cache, 'fresh']; }
